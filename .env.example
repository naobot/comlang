# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
#   Project Settings -> API keys
#
# The publishable key (sb_publishable_...) is safe in a browser bundle. Never put the
# secret / service_role key in this project — it bypasses row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
