  "orthography_rules": [
    {
      "name": "/j/ and /w/ in the onset",
      "effect": "/j/ is written <y> when it is the only onset of its syllable, or when the next segment is /i/; as the second member of an onset cluster, and not before /i/, it is written <i>.\n/w/ is written <w> when it is the only onset of its syllable, or when the next segment is /u/; as the second member of an onset cluster, and not before /u/, it is written <u>.",
      "examples": "/dusaju/ → dusayu \"motorcycle\" (j sole onset)\n/baphju/ → bappiu \"danger\" (j second member of an onset cluster, not before /i/)\n/kwawi/ → kuawi \"corridor\" (w sole onset)\n/bwi/ → bui \"road\" (w second member of an onset cluster, not before /u/)",
      "rule_order": 0,
      "summary": null
    },
    {
      "name": "/h/ after a consonant",
      "effect": "/h/ immediately after a consonant doubles that consonant in writing; the /h/ itself is dropped. Confirmed for both voiceless and voiced consonants (/p t s k l/ all attested).",
      "examples": "/dwekhal/ → duekkal \"last\" (k+h → kk)\n/kothwu/ → kottwu \"cellphone\" (t+h → tt)\n/beshi/ → bessi \"item\" (s+h → ss)\n/tumxelho/ → tumkhello \"managing\" (l+h → ll)",
      "rule_order": 1,
      "summary": null
    }
  ],
