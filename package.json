{
  "name": "comlang",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vp build",
    "preview": "vp preview",
    "type-check": "vue-tsc --build",
    "check": "vp check && vue-tsc --build",
    "test": "vp test",
