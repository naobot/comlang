    "prepare": "vp config",
    "import:lexicon": "vp exec tsx scripts/import-lexicon.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "supabase": "^2.116.0",
    "typescript": "~6.0.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.7",
    "yaml": "^2.9.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
