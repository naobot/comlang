  "orthography_rules": [
    {
      "name": "onset glides",
      "rule_order": 0,
      "effect": "/j/ becomes <y> when it is the sole onset of its syllable, or when the next segment is /i/; otherwise (as the second member of an onset cluster, not before /i/) it becomes <i>.\n/ɰ/ becomes <w> when it is the sole onset of its syllable, or when the next segment is /u/; otherwise (as the second member of an onset cluster, not before /u/) it becomes <u>.",
      "examples": "/dusaju/ → dusayu \"motorcycle\" (j sole onset)\n/baphju/ → bappiu \"danger\" (j second member of an onset cluster, not before /i/)\n/kɰaɰi/ → kuawi \"corridor\" (ɰ sole onset)\n/bɰi/ → bui \"road\" (ɰ second member of an onset cluster, not before /u/)"
    },
    {
      "name": "onset /ŋ/",
      "rule_order": 1,
      "effect": "/ŋ/ becomes <ng> as the onset of a word's first syllable. As the onset of a later syllable it becomes <ngw> — unless it is directly preceded and followed by a vowel with no other consonant between (see the intervocalic /ŋ/ rule), in which case that rule applies instead.",
      "examples": "/ŋap/ → ngap \"bad\" (word-initial)\n/kjosŋon/ → kiosngwon \"centre\" (onset of a later syllable, not intervocalic)"
    },
    {
      "name": "intervocalic /ŋ/",
      "rule_order": 2,
      "effect": "/ŋ/ becomes <ngg> when it is the onset of a non-initial syllable and is directly preceded and followed by a vowel, with no other consonant on either side.",
      "examples": "/baŋes/ → bangges \"ugly\"\n/doŋu/ → donggu \"moon\"\n/dopɰiŋe/ → dopuingge \"bar\"\n/soŋi/ → songgi \"following\""
    },
    {
      "name": "/h/ after a consonant",
      "rule_order": 3,
      "effect": "/h/ immediately after a consonant doubles that consonant in writing; the /h/ itself is dropped. Confirmed for both voiceless and voiced consonants (/p t s k l/ all attested).",
      "examples": "/dɰekhal/ → duekkal \"last\" (k+h → kk)\n/kothɰu/ → kottwu \"cellphone\" (t+h → tt)\n/beshi/ → bessi \"item\" (s+h → ss)\n/tumxelho/ → tumkhello \"managing\" (l+h → ll)"
    }
  ],
